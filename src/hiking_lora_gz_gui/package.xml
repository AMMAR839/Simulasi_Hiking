<?xml version="1.0"?>
<package format="3">
  <name>hiking_lora_gz_gui</name>
  <version>0.1.0</version>
  <description>Gazebo GUI keyboard plugin for the Hiking LoRa simulation.</description>
  <maintainer email="ammar@example.com">ammar</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>gz_gui_vendor</build_depend>
  <build_depend>gz_plugin_vendor</build_depend>
  <build_depend>rclcpp</build_depend>
  <build_depend>std_msgs</build_depend>

  <exec_depend>gz_gui_vendor</exec_depend>
  <exec_depend>gz_plugin_vendor</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
